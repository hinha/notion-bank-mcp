# Optional settings for local HTTP `serve` (operator only).
# End users do NOT need a .env file — OAuth uses mcp.notion.com (browser login).
#
# Never put tokens, CLIENT_ID, or CLIENT_SECRET here in a shared repo.

# NOTION_BANK_PUBLIC_URL=http://127.0.0.1:3737
# NOTION_BANK_PORT=3737
# NOTION_BANK_HOST=127.0.0.1
# NOTION_BANK_LOCAL_CALLBACK_PORT=8765
