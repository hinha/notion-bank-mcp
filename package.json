{
  "name": "notion-bank-mcp",
  "version": "1.4.3",
  "description": "Notion plan-bank MCP — npx install, browser OAuth via mcp.notion.com",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "notion-bank-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "serve": "tsx src/index.ts serve",
    "serve:prod": "node dist/index.js serve",
    "dev": "tsx src/index.ts serve",
    "stdio": "tsx src/index.ts --stdio",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "keywords": [
    "mcp",
    "notion",
    "notion-bank"
  ],
  "author": "hinha",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@notionhq/client": "^5.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
